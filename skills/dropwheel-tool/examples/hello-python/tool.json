{
  "$schema": "https://raw.githubusercontent.com/gavin-k/dropwheel/main/docs/tool-manifest.schema.json",
  "schema": 1,
  "id": "user.hello-python",
  "name": { "zh": "文件信息", "en": "File info" },
  "hint": { "zh": "写一份 -info.txt 放在旁边", "en": "Writes an -info.txt beside it" },
  "icon": "E943",
  "wheel": "actions",
  "kind": "script",
  "script": {
    "command": "python",
    "args": ["{toolDir}\\hello.py", "{input}", "{output}"],
    "perFile": true,
    "output": { "mode": "new-file", "extension": "txt", "suffix": "-info" },
    "timeoutSeconds": 60
  },
  "undo": "recycle"
}
