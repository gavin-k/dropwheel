<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌，与 docs/design/README.md 保持一致。
  浅色 / 深色由 ThemeDictionaries 切换；WCAG AA 已在设计系统板上核对。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="DwAccent">#C2410C</Color>
      <Color x:Key="DwAccentHover">#9A3412</Color>
      <Color x:Key="DwAccentSoft">#FFF1E7</Color>
      <Color x:Key="DwAccentLine">#F97316</Color>
      <Color x:Key="DwOnAccent">#FFFFFF</Color>
      <Color x:Key="DwSuccess">#0F7B3E</Color>
      <Color x:Key="DwWarning">#8A4B00</Color>
      <Color x:Key="DwDanger">#B42318</Color>
      <Color x:Key="DwBg">#F7F7F7</Color>
      <Color x:Key="DwSurface">#FFFFFF</Color>
      <Color x:Key="DwSurface2">#F3F3F3</Color>
      <Color x:Key="DwBorder">#E3E3E3</Color>
      <Color x:Key="DwBorderStrong">#CFCFCF</Color>
      <Color x:Key="DwText">#1A1A1A</Color>
      <Color x:Key="DwText2">#555555</Color>
      <Color x:Key="DwText3">#6B6B6B</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="DwAccent">#FB923C</Color>
      <Color x:Key="DwAccentHover">#FDBA74</Color>
      <Color x:Key="DwAccentSoft">#3A2214</Color>
      <Color x:Key="DwAccentLine">#FB923C</Color>
      <Color x:Key="DwOnAccent">#1A0D04</Color>
      <Color x:Key="DwSuccess">#4ADE80</Color>
      <Color x:Key="DwWarning">#FBBF24</Color>
      <Color x:Key="DwDanger">#F87171</Color>
      <Color x:Key="DwBg">#141414</Color>
      <Color x:Key="DwSurface">#1F1F1F</Color>
      <Color x:Key="DwSurface2">#262626</Color>
      <Color x:Key="DwBorder">#333333</Color>
      <Color x:Key="DwBorderStrong">#454545</Color>
      <Color x:Key="DwText">#F2F2F2</Color>
      <Color x:Key="DwText2">#C2C2C2</Color>
      <Color x:Key="DwText3">#A3A3A3</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Geometry -->
  <CornerRadius x:Key="DwControlRadius">4</CornerRadius>
  <CornerRadius x:Key="DwCardRadius">8</CornerRadius>
  <!-- The wheel's sizes are in WheelGeometry (DropWheel.Core), which both draws it and hit-tests it. -->

  <!-- Motion (ms). 全部受 UISettings.AnimationsEnabled 控制 -->
  <x:Double x:Key="DwMotionWheelIn">150</x:Double>
  <x:Double x:Key="DwMotionSelect">100</x:Double>
  <x:Double x:Key="DwMotionCheck">320</x:Double>
</ResourceDictionary>
