<?xml version="1.0" encoding="utf-8"?>
<!--
  Referenced by DropWheel.App.csproj as win-$(Platform).pubxml. Used by `dotnet publish` (release.yml,
  scripts/build-windows.ps1); a packaged WinUI app ships self-contained .NET like the official template.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishDir>bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
