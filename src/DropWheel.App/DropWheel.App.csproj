<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DropWheel.App</RootNamespace>
    <AssemblyName>DropWheel</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 打包（MSIX）为默认形态：Win11 右键菜单、通知、Store、winget 都需要包标识。 -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <ApplicationIcon>Assets/DropWheel.ico</ApplicationIcon>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets/**" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    ffmpeg sidecar (LGPL, kept out of process, see ADR-0003), fetched into tools/sidecars by scripts/fetch-sidecars.{sh,ps1}.
    Ships as sidecars/ffmpeg next to DropWheel.exe. Without it the app still builds and greys out audio and video targets.
    The RuntimeIdentifier is only known up front when it is passed in (winapp pack, publish); a plain build has the Platform.
  -->
  <PropertyGroup>
    <SidecarArch Condition="$(RuntimeIdentifier.EndsWith('arm64')) or ('$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64')">arm64</SidecarArch>
    <SidecarArch Condition="'$(SidecarArch)' == ''">x64</SidecarArch>
    <SidecarDir>$(MSBuildThisFileDirectory)../../tools/sidecars/ffmpeg/$(SidecarArch)/</SidecarDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(SidecarDir)ffmpeg.exe')">
    <Content Include="$(SidecarDir)**" Exclude="$(SidecarDir).sha256" Link="sidecars/ffmpeg/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SkiaSharp's native package carries libSkiaSharp.pdb (85 MB) next to the DLL; it is not shipped. -->
  <Target Name="DropNativeSymbols" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/L.cs" Link="L.cs" />
    <EmbeddedResource Include="Strings.en.json" LogicalName="Strings.en.json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DropWheel.Core/DropWheel.Core.csproj" />
    <ProjectReference Include="../DropWheel.Shell/DropWheel.Shell.csproj" />
    <ProjectReference Include="../DropWheel.Engines/DropWheel.Engines.csproj" />
  </ItemGroup>

  <!-- Visual Studio: 让 Package.appxmanifest 出现在项目中并启用部署 -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

</Project>
