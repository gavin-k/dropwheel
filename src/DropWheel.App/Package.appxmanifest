<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap5 rescap com desktop4 desktop5">

  <!-- TODO: Publisher 必须与签名证书 Subject 一致；Store 提交时由合作伙伴中心覆盖 -->
  <Identity Name="GavinLee.DropWheel" Publisher="CN=Gavin Lee" Version="0.1.0.0" />

  <Properties>
    <DisplayName>DropWheel</DisplayName>
    <PublisherDisplayName>Gavin Lee</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="DropWheel"
        Description="拖一下，松手，转好了。本地离线文件转换器。"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- 命令行别名：dropwheel <files...> -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="dropwheel.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>

        <!--
          登录 Windows 时启动，只进托盘。Enabled：用户启动过一次之后生效；用户在任务管理器或系统设置里关掉后，
          只能由用户在那里重新打开。Executable / EntryPoint 沿用 Application 的。
        -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="DropWheelStartup" Enabled="true" DisplayName="DropWheel" />
        </uap5:Extension>

        <!--
          Win11 新式右键菜单「用 DropWheel 转换」。
          M2 启用：取消注释并把 DropWheel.ContextMenu.dll 放入包。
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="DropWheel">
              <com:Class Id="7D1E9A4C-5B2F-4E7A-9C3D-1F2E3D4C5B6A" Path="DropWheel.ContextMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ConvertWithDropWheel" Clsid="7D1E9A4C-5B2F-4E7A-9C3D-1F2E3D4C5B6A" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        -->
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
