<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DropWheel.Engines</RootNamespace>
    <Description>Engine adapters implementing IConverter. Heavy engines (ffmpeg, soffice) run as sidecar processes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DropWheel.Core/DropWheel.Core.csproj" />
  </ItemGroup>

  <!--
    M0 只需要 Image 引擎。其余包在对应里程碑再打开，避免首次 restore 拉下数百 MB 原生二进制。
  -->
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" />
    <!-- <PackageReference Include="PDFtoImage" /> -->
    <!-- <PackageReference Include="PdfPig" /> -->
    <!-- <PackageReference Include="PDFsharp" /> -->
    <!-- <PackageReference Include="DocumentFormat.OpenXml" /> -->
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

</Project>
